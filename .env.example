MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=quarterly_reports

# JWT Configuration
AUTH_JWT_SECRET=QR8ZHx/Epqu2TumFsS63+a1+357DYJCpm9WXYS9OcqtW1yTCyeMPjwDd5glyx05N

# Email Configuration (OTP Verification via Brevo API)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@yourcompany.com

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Job Security
# Used to authenticate cron job requests from Vercel or external cron services
# Set this in Netlify UI (Site > Environment variables) as well
# External cron services must send this as header: x-cron-secret
CRON_SECRET=your-cron-secret-here
